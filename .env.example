# QA Bot v0.2 — configuration template
# Copy to .env (`cp .env.example .env`). Every key is namespaced QA_BOT_*.
# All values below are the built-in defaults; only set what you want to change.

# --- Core -------------------------------------------------------------------
QA_BOT_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR (applied by main.py)
QA_BOT_DEBUG=false

# --- Storage ------------------------------------------------------------------
# Relative paths anchor to the package root, NOT the current working directory.
QA_BOT_ARTIFACTS_DIR=artifacts

# --- SSRF gate (fail-closed) --------------------------------------------------
# Loopback/private/link-local hosts are blocked by default.
QA_BOT_ALLOW_PRIVATE_HOSTS=false # local-dev escape hatch ONLY
QA_BOT_RESOLVE_HOSTS=true        # DNS-resolve target hosts and block any private
                                 # address in the answer (anti DNS-rebinding).
                                 # Set false only for offline/demo runs.

# --- Sandbox (PROTOTYPE: destructive-action gate REMOVED) ---------------------
# Destructive actions (delete/pay/transfer/...) now run by default.
# The external-navigation domain allowlist still applies when configured:
# QA_BOT_SANDBOX_ALLOWED_DOMAINS=example.com,app.example.com   # empty = no restriction

# --- Browser budgets ------------------------------------------------------------
QA_BOT_ACTION_TIMEOUT_MS=5000
QA_BOT_NAV_TIMEOUT_MS=30000
QA_BOT_CASE_BUDGET_S=60
QA_BOT_RUN_BUDGET_S=600
QA_BOT_SESSION_GATE_ATTEMPTS=3
QA_BOT_SESSION_GATE_TIMEOUT_MS=30000

# --- Tunnel profile (slow ephemeral dev links) ---------------------------------
QA_BOT_TUNNEL_ACTION_TIMEOUT_MS=10000
QA_BOT_TUNNEL_NAV_TIMEOUT_MS=60000
QA_BOT_TUNNEL_SESSION_GATE_TIMEOUT_MS=60000
QA_BOT_TUNNEL_CASE_BUDGET_S=120

# --- Step budgets ----------------------------------------------------------------
QA_BOT_MAX_STEPS_SINGLE=6
QA_BOT_MAX_STEPS_JOURNEY=12

# --- Planner (LLM-ONLY: langchain-openai against any OpenAI-compatible endpoint) --
# There is NO mock provider — planning hard-fails with a clear error if the key or
# model is missing/invalid. Point these at OpenAI or your own compatible gateway
# (Ollama/vLLM/LiteLLM/Azure-style proxies all work via QA_BOT_LLM_BASE_URL).
QA_BOT_PLANNER_PROVIDER=openai-compatible   # only supported value
QA_BOT_PLANNER_MODEL=gpt-4o-mini            # your OpenAI-compatible model id (Studio "Default" option loads this)
# Studio Phase 3 -> Model Catalog tab dropdown (comma-separated). Includes Ollama models;
# point QA_BOT_LLM_BASE_URL at http://localhost:11434/v1 to use them.
QA_BOT_MODEL_CATALOG=gpt-4o-mini,gpt-4o,gpt-4.1-mini,o4-mini,ollama/llama3.1,ollama/qwen2.5-coder,ollama/phi4
QA_BOT_LLM_BASE_URL=             # e.g. https://api.openai.com/v1 — or http://localhost:11434/v1 for Ollama
QA_BOT_LLM_API_KEY=              # prefer exporting this in your shell over storing it here
QA_BOT_LLM_TIMEOUT_S=30
QA_BOT_LLM_MAX_RETRIES=1

# --- Ollama (local OpenAI-compatible endpoint) --------------------------------
# Run models locally without an API key: start ollama (`ollama serve`, then
# `ollama pull llama3.1`) and set:
#   QA_BOT_LLM_BASE_URL=http://localhost:11434/v1
#   QA_BOT_LLM_API_KEY=ollama        (any non-empty placeholder value works)
#   QA_BOT_PLANNER_MODEL=ollama/llama3.1
# Ollama ids are already listed in QA_BOT_MODEL_CATALOG above for the Studio
# Model Catalog tab.

# --- Uploads -----------------------------------------------------------------------
QA_BOT_MAX_UPLOAD_BYTES=10485760   # 10 MiB cap at the ingest boundary

# --- API ----------------------------------------------------------------------------
QA_BOT_API_V2_PREFIX=/api/v2
QA_BOT_MAX_CONCURRENT_SESSIONS=3   # browser-session semaphore in the API process
